{
  "name": "lumenclip",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "env:check": "node scripts/check-env.mjs",
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:design-tokens": "node scripts/check-design-tokens.mjs",
    "test": "vitest run --configLoader runner",
    "test:live": "RUN_LIVE=1 vitest run --config vitest.live.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:live": "E2E_MODE=live playwright test",
    "mcp": "NODE_OPTIONS='--conditions=react-server' tsx scripts/lumenclip-mcp.mts",
    "mcp:docs": "tsx scripts/generate-mcp-docs.ts",
    "mcp:docs:check": "tsx scripts/generate-mcp-docs.ts --check",
    "railway:db:migrate": "tsx scripts/railway-migrate.mts",
    "railway:db:generate": "drizzle-kit generate",
    "railway:db:studio": "drizzle-kit studio",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@clerk/nextjs": "^7.6.5",
    "@clerk/ui": "1.27.1",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@hono/zod-openapi": "^1.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@scalar/nextjs-api-reference": "^0.11.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.4",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "@xyflow/react": "^12.11.2",
    "ag-charts-types": "^14.0.0",
    "ag-grid-community": "^36.0.0",
    "ag-grid-react": "^36.0.0",
    "ag-stack": "^36.0.0",
    "canvas": "3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fabric": "7.4.0",
    "fumadocs-core": "16.11.5",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.11.5",
    "hono": "^4.13.0",
    "jsoneditor": "^10.4.3",
    "jszip": "^3.10.1",
    "konva": "^9.3.22",
    "luxon": "^3.7.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-appwrite": "30.0.0",
    "p-retry": "^8.0.0",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^17.0.0",
    "react-icons": "^5.7.0",
    "react-konva": "^19.2.5",
    "recharts": "^3.9.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.17",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsoneditor": "^9.9.6",
    "@types/luxon": "^3.7.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}

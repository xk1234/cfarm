diff --git a/frontend/src/lib/components/mediaResult.ts b/frontend/src/lib/components/mediaResult.ts
new file mode 100644
index 0000000..2499bd5
--- /dev/null
+++ b/frontend/src/lib/components/mediaResult.ts
@@ -0,0 +1,68 @@
+export type MediaResultItem = {
+	mediaType: 'image' | 'video'
+	mediaUrl: string
+	previewUrl?: string
+	label: string
+}
+
+const MAX_MEDIA_RESULTS = 24
+
+export function extractMediaResults(result: unknown): MediaResultItem[] {
+	const items: MediaResultItem[] = []
+	const seen = new Set<string>()
+
+	function visit(value: unknown, depth: number) {
+		if (items.length >= MAX_MEDIA_RESULTS || depth > 8 || value == null) return
+		if (Array.isArray(value)) {
+			for (const item of value) visit(item, depth + 1)
+			return
+		}
+		if (typeof value !== 'object') return
+
+		const record = value as Record<string, unknown>
+		const mediaType =
+			record.mediaType === 'image' || record.mediaType === 'video'
+				? record.mediaType
+				: undefined
+		const mediaUrl = firstPublicUrl(record.mediaUrl, record.url)
+		if (mediaType && mediaUrl) {
+			const key = `${mediaType}:${mediaUrl}`
+			if (!seen.has(key)) {
+				seen.add(key)
+				const variant =
+					typeof record.variantIndex === 'number' ? ` ${record.variantIndex + 1}` : ''
+				items.push({
+					mediaType,
+					mediaUrl,
+					previewUrl: firstPublicUrl(record.previewUrl, record.thumbnailUrl),
+					label:
+						firstText(record.label, record.caption, record.name) ??
+						`${mediaType === 'video' ? 'Video' : 'Image'} output${variant}`
+				})
+			}
+			return
+		}
+
+		for (const nested of Object.values(record)) visit(nested, depth + 1)
+	}
+
+	visit(result, 0)
+	return items
+}
+
+function firstPublicUrl(...values: unknown[]) {
+	for (const value of values) {
+		if (typeof value !== 'string') continue
+		try {
+			const url = new URL(value)
+			if (url.protocol === 'https:' || url.protocol === 'http:') return url.toString()
+		} catch {
+			// A media result must be an explicit, absolute HTTP URL.
+		}
+	}
+	return undefined
+}
+
+function firstText(...values: unknown[]) {
+	return values.find((value): value is string => typeof value === 'string' && value.trim().length > 0)
+}

{
  "$schema": "https://lumenclip.app/schemas/slideshow-spec-v1.json",
  "version": 1,
  "id": "starter-photo-card",
  "name": "Photo card",
  "description": "A 16:9 photo card over a darkened full-bleed background, with an outlined caption above it.",
  "canvas": {
    "preset": "9:16",
    "background": "#111111"
  },
  "fonts": [
    {
      "family": "Inter",
      "weights": [
        800
      ]
    }
  ],
  "meta": {
    "starter": true,
    "category": "photo"
  },
  "slots": {
    "slides": {
      "type": "list",
      "label": "Slides",
      "minItems": 1,
      "maxItems": 35,
      "item": {
        "background": {
          "type": "image",
          "label": "Background photo",
          "required": true
        },
        "card": {
          "type": "image",
          "label": "Card photo",
          "required": true
        },
        "caption": {
          "type": "text",
          "label": "Caption",
          "maxLength": 160,
          "multiline": true
        }
      }
    }
  },
  "slides": [
    {
      "repeat": {
        "slot": "slides",
        "as": "s"
      },
      "slide": {
        "id": "card-{{index1}}",
        "layers": [
          {
            "id": "background",
            "type": "image",
            "src": {
              "slot": "s.background"
            },
            "frame": {
              "inset": 0
            },
            "fit": "cover",
            "filters": {
              "blur": 0.35,
              "brightness": -0.2
            }
          },
          {
            "id": "card",
            "type": "image",
            "src": {
              "slot": "s.card"
            },
            "fit": "cover",
            "cornerRadius": 28,
            "border": {
              "color": "#FFFFFF",
              "width": 8
            },
            "shadow": {
              "color": "rgba(0,0,0,0.45)",
              "blur": 40,
              "offsetY": 16
            },
            "frame": {
              "x": "50%",
              "y": "50%",
              "width": "84%",
              "height": "26.6%",
              "anchor": "center"
            }
          },
          {
            "id": "caption",
            "type": "text",
            "if": {
              "slot": "s.caption"
            },
            "text": "{{s.caption}}",
            "markup": "emphasis",
            "style": {
              "fontFamily": "Inter",
              "fontWeight": 800,
              "fontSize": {
                "min": 40,
                "max": 72
              },
              "color": "#FFFFFF",
              "align": "center",
              "lineHeight": 1.12,
              "stroke": {
                "color": "rgba(0,0,0,0.88)",
                "width": 11,
                "join": "round"
              },
              "maxLines": 4,
              "overflow": "shrink"
            },
            "emphasisStyle": {
              "color": "#FFF176"
            },
            "frame": {
              "x": "50%",
              "y": "34%",
              "width": "84%",
              "anchor": "bottom"
            }
          }
        ]
      }
    }
  ]
}

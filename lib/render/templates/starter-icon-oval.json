          "frame": {
            "x": "50.0%",
            "y": "81.8%",
            "width": 146,
            "height": 146,
            "anchor": "center"
          },
          "children": [
            {
              "id": "icon5-card",
              "type": "shape",
              "shape": "rect",
              "fill": "#FFFDF8",
              "cornerRadius": "22%",
              "stroke": {
                "color": "#27231F",
                "width": 5
              },
              "frame": {
                "inset": 0
              }
            },
            {
              "id": "icon5-image",

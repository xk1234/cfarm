              },
              "fit": "contain",
              "frame": {
                "x": "50%",
                "y": "50%",
                "width": "74%",
                "height": "74%",
                "anchor": "center"
              }
            }
          ]
        },
        {
          "id": "title",
          "type": "text",
          "if": {
            "slot": "title"
          },
          "text": "{{title}}",
          "style": {
            "fontFamily": "Inter",
            "fontWeight": 800,
            "fontSize": {
              "min": 40,
              "max": 64
            },
            "color": "#27231F",
            "align": "center",
            "lineHeight": 1.1,
            "maxLines": 3,
            "overflow": "shrink"
          },
          "frame": {
            "x": "50%",
            "y": "56%",
            "width": "52%",
            "anchor": "center"
          }
        }
      ]
    }
  ]
}

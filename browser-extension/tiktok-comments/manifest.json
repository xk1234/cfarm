{
  "manifest_version": 3,
  "name": "LumenClip TikTok Comments",
  "version": "1.0.0",
  "description": "Collects top-level comments and posts only explicitly approved replies in your logged-in TikTok session.",
  "permissions": ["storage", "tabs", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://cfarm-eight.vercel.app/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/@*/*"],
      "js": ["tiktok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cfarm-eight.vercel.app/*", "http://localhost/*"],
      "js": ["lumenclip-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "LumenClip TikTok Comments" }
}

{
  "manifest_version": 3,
  "name": "LumenClip companion",
  "version": "2.3.1",
  "description": "Imports TikTok Studio analytics and reviews, approves, and sends drafted comment replies through your logged-in TikTok session.",
  "permissions": ["storage", "tabs", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://cfarm-eight.vercel.app/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/tiktokstudio/content*"],
      "js": ["studio-discovery-helpers.js", "studio-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tiktok.com/tiktokstudio/analytics/*"],
      "js": ["capture-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/tiktokstudio/analytics/*"],
      "js": ["capture-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.tiktok.com/@*/*"],
      "js": ["tiktok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cfarm-eight.vercel.app/*", "http://localhost/*"],
      "js": ["lumenclip-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "LumenClip companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  }
}

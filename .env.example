# Clerk owns user identity and browser sessions. The secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Legacy Appwrite source. Runtime services do not need these once both Railway
# flags are active; keep source credentials outside deployed environments.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
ENABLE_LOCAL_AUTOMATION_WORKER=false
# Internal debug/testing routes are disabled automatically in production.
ENABLE_INTERNAL_TOOLS=false
APPWRITE_DATABASE_ID=cfarm

# Railway is the runtime default. Set either flag to appwrite only during an
# explicit rollback window.
LUMENCLIP_DATA_BACKEND=railway
LUMENCLIP_ASSET_BACKEND=railway
DATABASE_URL=
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_BUCKET_REGION=auto
# Railway injects this automatically; the shared start command dispatches to
# the web, job worker, or scheduler process using the service name.
RAILWAY_SERVICE_NAME=
# Unified post-model rollout controls. Keep both legacy until the dedicated
# tables are provisioned and reconciled. Read: legacy|union-shadow|canonical.
# Write: legacy|dual|canonical.
POST_REPOSITORY_READ_MODE=legacy
POST_REPOSITORY_WRITE_MODE=legacy

# Optional overrides used only while provisioning self-hosted Appwrite.
LOCAL_APPWRITE_CONSOLE_EMAIL=
LOCAL_APPWRITE_CONSOLE_PASSWORD=

# One-time source project for `pnpm appwrite:clone-schema` (cloud → local).
# Only needed while cloning schema to a self-hosted instance; remove afterward.
# See docs/reference/local-appwrite.md.
SRC_APPWRITE_ENDPOINT=
SRC_APPWRITE_PROJECT_ID=
SRC_APPWRITE_API_KEY=
# Optional owner used by non-request maintenance scripts.
LUMENCLIP_SYSTEM_OWNER_ID=
# Explicit owner for the local stdio MCP server. Required when APPWRITE_ENDPOINT
# points to localhost so a cloud system owner cannot silently produce empty reads.
LUMENCLIP_MCP_OWNER_ID=

# Windmill owns generation workflow orchestration. The app queues named flows
# and exposes only a bearer-protected single-stage execution boundary.
WINDMILL_BASE_URL=
WINDMILL_WORKSPACE_ID=
WINDMILL_TOKEN=
WINDMILL_SHARED_SECRET=

# Optional default shown when attaching an InfluLab account. Users can enter a
# different self-hosted URL in Connected accounts.
INFLULAB_URL=
# Read-only LumenLab hook import. The token must match the server-side
# LUMENLAB_INTEGRATION_TOKEN configured by the target LumenLab deployment.
LUMENLAB_URL=
LUMENLAB_INTEGRATION_TOKEN=
# Optional one-time assignee for records created before authentication.

# TikTok Studio captures are mirrored to this deployment so the public MCP can
# read them. Keep the signing secret server-only and identical locally/Railway.
TIKTOK_STUDIO_CLOUD_ORIGIN=https://web-production-bd480.up.railway.app
TIKTOK_STUDIO_CAPTURE_SECRET=

# Slideshow and content generation (required for generation)
OPENROUTER_API_KEY=

# Optional integrations
APIFY_KEY=
APIFY_YOUTUBE_ACTOR=pintostudio/youtube-transcript-scraper
APIFY_REDDIT_ACTOR=trudax/reddit-scraper-lite
# Optional override. Small-batch X discovery defaults to this Actor in code.
APIFY_TWITTER_ACTOR=apidojo/twitter-scraper-lite
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
# Photo-post importer; defaults to maximedupre/tiktok-slideshow-downloader.
APIFY_TIKTOK_SLIDESHOW_ACTOR=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
FAL_KEY=
FAL_WHISPER_MODEL=fal-ai/whisper
ELEVENLABS_API_KEY=
# Paid talking-actor generation remains disabled unless exactly true.
ENABLE_UGC_AUTOMATION=false
DEEPL_KEY=
KIE_KEY=
PEXELS_KEY=
POSTFAST_API_KEY=
RENDI_API_KEY=
# Telegram reminders. BASE_URL must be the public HTTPS app origin so Telegram
# can reach the confirmation callback (for example https://app.example.com).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
BASE_URL=
# Required for signed public slideshow preview and download links.
SLIDESHOW_SHARE_SECRET=

# Test tooling (database-backed tests use APPWRITE_DATABASE_ID above)
RUN_LIVE=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
# Single-user gate: comma-separated Clerk user ids (user_…) allowed to use the
# app. Required in production (unset = nobody); unset in dev = any signed-in user.
LUMENCLIP_ALLOWED_USER_IDS=

# Optional Clerk testing token for logged-in e2e runs.
CLERK_TESTING_TOKEN=

# Appwrite Cloud data + files (server-only; never NEXT_PUBLIC_).
# Endpoint example: https://<region>.cloud.appwrite.io/v1
# Local shared stack: http://localhost:9080/v1
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Optional overrides (defaults: lumenclip, media, renders).
APPWRITE_DATABASE_ID=
APPWRITE_BUCKET_MEDIA=
APPWRITE_BUCKET_RENDERS=
# Optional: "memory" runs on in-process repositories (tests force this).
LUMENCLIP_DATA_BACKEND=
# Local e2e only (lib/e2e-auth.ts): with LUMENCLIP_DATA_BACKEND=memory and
# NODE_ENV != production, every request is signed in as this id without Clerk.
LUMENCLIP_E2E_USER_ID=

# Structured log verbosity.
LOG_LEVEL=info

# Workspace API key for the local stdio MCP server (`pnpm mcp`); create one in Settings → API keys.
LUMENCLIP_API_KEY=

# Background worker (scripts/worker.mts).
# Optional private wake URL, e.g. http://worker.railway.internal:8080/wake
WORKER_WAKE_URL=
WORKER_PORT=
WORKER_CONCURRENCY=

# Publishing (SocialBu). Publishing shows "SocialBu not connected" when unset.
SOCIALBU_API_TOKEN=
# Optional: signs SocialBu postback URLs (needs an https BASE_URL).
SOCIALBU_POSTBACK_SECRET=

# Optional integrations
APIFY_KEY=
PEXELS_KEY=
# Public HTTPS app origin (for example https://app.example.com); used for
# share links and signed file URLs.
BASE_URL=
# Signs public slideshow share links.
SLIDESHOW_SHARE_SECRET=
# Optional; signs short-lived file URLs. Defaults to SLIDESHOW_SHARE_SECRET.
FILE_URL_SECRET=
# Live provider tests are disabled unless explicitly enabled.
RUN_LIVE=

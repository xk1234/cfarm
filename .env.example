# Internal debug/testing routes are disabled automatically in production.
ENABLE_INTERNAL_TOOLS=false

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Optional authenticated documentation capture (Clerk development user)
AUTOMATIONS_DOCS_URL=http://localhost:3000
AUTOMATIONS_DOCS_EMAIL=
AUTOMATION_DOCS_URL=http://localhost:3000
AUTOMATION_DOCS_EMAIL=
CLERK_TESTING_TOKEN=

# Railway application storage.
DATABASE_URL=
# Optional Railway queue namespace and structured log verbosity.
PG_BOSS_SCHEMA=lumenclip_queue
LOG_LEVEL=info
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_BUCKET_REGION=auto
# Unified post-model rollout controls. Keep both legacy until the dedicated
# tables are provisioned and reconciled. Read: legacy|union-shadow|canonical.
# Write: legacy|dual|canonical.
POST_REPOSITORY_READ_MODE=legacy
POST_REPOSITORY_WRITE_MODE=legacy

# Optional owner used by non-request maintenance scripts.
LUMENCLIP_SYSTEM_OWNER_ID=
# Explicit owner for the local stdio MCP server.
LUMENCLIP_MCP_OWNER_ID=
# Optional one-time assignee for records created before authentication.

# TikTok Studio captures are mirrored to this deployment so the public MCP can
# read them. Keep the signing secret server-only and identical locally/Vercel.
TIKTOK_STUDIO_CLOUD_ORIGIN=https://cfarm-eight.vercel.app
TIKTOK_STUDIO_CAPTURE_SECRET=
TIKTOK_COMMENTS_CAPTURE_SECRET=

# Slideshow and content generation (required for generation)
OPENROUTER_API_KEY=

# Optional integrations
APIFY_KEY=
APIFY_YOUTUBE_ACTOR=pintostudio/youtube-transcript-scraper
APIFY_REDDIT_ACTOR=trudax/reddit-scraper-lite
# Optional override. Small-batch X discovery defaults to this Actor in code.
APIFY_TWITTER_ACTOR=apidojo/twitter-scraper-lite
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
# Photo-post importer; defaults to maximedupre/tiktok-slideshow-downloader.
APIFY_TIKTOK_SLIDESHOW_ACTOR=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
# Amazon.sg Associates tracking tag used to turn eligible product URLs into
# commission-earning Special Links (for example, your-store-22).
AMAZON_ASSOCIATE_TAG=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
FAL_KEY=
FAL_WHISPER_MODEL=fal-ai/whisper
ELEVENLABS_API_KEY=
# Paid talking-actor generation remains disabled unless exactly true.
ENABLE_UGC_AUTOMATION=false
DEEPL_KEY=
KIE_KEY=
PEXELS_KEY=
POSTFAST_API_KEY=
RENDI_API_KEY=
# Telegram reminders. BASE_URL must be the public HTTPS app origin so Telegram
# can reach the confirmation callback (for example https://app.example.com).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
BASE_URL=
# Set explicitly to rotate public slideshow download links independently.
SLIDESHOW_SHARE_SECRET=
# Optional; defaults to SLIDESHOW_SHARE_SECRET. Set explicitly to rotate public
# generated-video viewer links independently.
OUTPUT_SHARE_SECRET=
# Live provider tests are disabled unless explicitly enabled.
RUN_LIVE=

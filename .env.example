# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Optional Clerk testing token for logged-in e2e runs.
CLERK_TESTING_TOKEN=

# Railway application storage.
DATABASE_URL=
# Optional Railway queue namespace and structured log verbosity.
PG_BOSS_SCHEMA=lumenclip_queue
LOG_LEVEL=info
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_BUCKET_REGION=auto
# Unified post-model rollout controls. Keep both legacy until the dedicated
# tables are provisioned and reconciled. Read: legacy|union-shadow|canonical.
# Write: legacy|dual|canonical.
POST_REPOSITORY_READ_MODE=legacy
POST_REPOSITORY_WRITE_MODE=legacy

# Optional owner used by non-request maintenance scripts.
LUMENCLIP_SYSTEM_OWNER_ID=
# Explicit owner for the local stdio MCP server.
LUMENCLIP_MCP_OWNER_ID=

# Optional integrations
APIFY_KEY=
PEXELS_KEY=
# SocialBu publishing (https://socialbu.com/api/v1). Without a token the app
# shows "SocialBu not connected" and publishing is disabled.
SOCIALBU_API_TOKEN=
# Optional: signs SocialBu postback URLs (needs an https BASE_URL).
SOCIALBU_POSTBACK_SECRET=
# Public HTTPS app origin (for example https://app.example.com).
BASE_URL=
# Set explicitly to rotate public slideshow download links independently.
SLIDESHOW_SHARE_SECRET=
# Optional; defaults to SLIDESHOW_SHARE_SECRET. Set explicitly to rotate public
# generated-video viewer links independently.
OUTPUT_SHARE_SECRET=
# Live provider tests are disabled unless explicitly enabled.
RUN_LIVE=
